# Copy to .env. Placeholders only; never commit real credentials.
DATABASE_URL=postgresql://owner:CHANGE_ME@HOST:5432/cooked?sslmode=require
DATABASE_URL_APP=postgresql://app_rw:CHANGE_ME@HOST:5432/cooked?sslmode=require
DATABASE_URL_AGENT=postgresql://agent_ro:CHANGE_ME@HOST:5432/cooked?sslmode=require
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cooked
POSTGRES_PORT=5432

GEMINI_API_KEY=
GEMINI_MODEL=
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
ELEVENLABS_API_KEY=
VOICE_ID_NARRATOR=
VOICE_ID_COACH=
ELEVENLABS_MODEL=
ANTHROPIC_API_KEY=
DO_TOKEN=
DO_APP_ID=

MODEL_ARTIFACT_DIR=models/
# DEMO_MODE=1 blocks every outbound call; narration and voice replay from Postgres caches
DEMO_MODE=0
WATCHTOWER_INTERVAL_SECONDS=1800
CORS_ORIGINS=http://localhost:3000
API_ROOT_PATH=
NEXT_PUBLIC_API_URL=http://localhost:8000
DEPLOYED_API_URL=
DEPLOYED_WEB_URL=

# Sign-in. AUTH_SECRET signs session cookies (make env generates one).
# Google: create an OAuth client (Web application) in Google Cloud Console; authorized redirect URI
# http://localhost:3000/api/auth/callback/google (and your deployed URL). Without these, the app
# offers "Continue as guest".
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public origin when deployed behind a proxy, e.g. https://cooked.ondigitalocean.app
AUTH_URL=
